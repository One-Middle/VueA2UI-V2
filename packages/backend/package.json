{
  "name": "@a2ui-platform/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "node --env-file=../../.env ./node_modules/prisma/build/index.js generate",
    "prisma:push": "node --env-file=../../.env ./node_modules/prisma/build/index.js db push",
    "prisma:migrate": "node --env-file=../../.env ./node_modules/prisma/build/index.js migrate dev",
    "repair:snapshots": "node --env-file=../../.env --import tsx src/scripts/repair-current-snapshots.ts",
    "skill:sync": "node --env-file=../../.env --import tsx src/scripts/sync-builtin-skills.ts"
  },
  "dependencies": {
    "@a2ui-platform/agent": "workspace:*",
    "@a2ui-platform/shared": "workspace:*",
    "@prisma/client": "^6.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.5.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
