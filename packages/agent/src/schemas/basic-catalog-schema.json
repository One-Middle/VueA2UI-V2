{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2ui.org/specification/v0.9/catalogs/basic/catalog.json",
  "title": "A2UI Basic Catalog Component Schema",
  "description": "Basic Catalog 中 18 个组件的属性 JSON Schema 定义",
  "$defs": {
    "dataBinding": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string" }
      },
      "additionalProperties": false
    },
    "propertyScript": {
      "type": "object",
      "required": ["script"],
      "properties": {
        "script": {
          "type": "object",
          "required": ["code", "deps"],
          "properties": {
            "code": { "type": "string", "minLength": 1, "maxLength": 2000 },
            "deps": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": { "type": "string" }
            },
            "fallback": {}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "stringOrBinding": {
      "oneOf": [
        { "type": "string" },
        { "$ref": "#/$defs/dataBinding" },
        { "$ref": "#/$defs/propertyScript" }
      ]
    },
    "numberOrBinding": {
      "oneOf": [
        { "type": "number" },
        { "$ref": "#/$defs/dataBinding" },
        { "$ref": "#/$defs/propertyScript" }
      ]
    },
    "booleanOrBinding": {
      "oneOf": [
        { "type": "boolean" },
        { "$ref": "#/$defs/dataBinding" },
        { "$ref": "#/$defs/propertyScript" }
      ]
    },
    "componentRef": {
      "oneOf": [
        { "type": "string" },
        { "type": "object" }
      ]
    },
    "styleStringOrScript": {
      "oneOf": [
        { "type": "string" },
        { "$ref": "#/$defs/propertyScript" }
      ]
    },
    "styleNumberOrScript": {
      "oneOf": [
        { "type": "number" },
        { "$ref": "#/$defs/propertyScript" }
      ]
    },
    "styleStringNumberOrScript": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "$ref": "#/$defs/propertyScript" }
      ]
    },
    "controlledStyle": {
      "type": "object",
      "properties": {
        "width": { "$ref": "#/$defs/styleStringOrScript" },
        "height": { "$ref": "#/$defs/styleStringOrScript" },
        "minWidth": { "$ref": "#/$defs/styleStringOrScript" },
        "maxWidth": { "$ref": "#/$defs/styleStringOrScript" },
        "minHeight": { "$ref": "#/$defs/styleStringOrScript" },
        "maxHeight": { "$ref": "#/$defs/styleStringOrScript" },
        "padding": { "$ref": "#/$defs/styleStringOrScript" },
        "paddingX": { "$ref": "#/$defs/styleStringOrScript" },
        "paddingY": { "$ref": "#/$defs/styleStringOrScript" },
        "margin": { "$ref": "#/$defs/styleStringOrScript" },
        "marginX": { "$ref": "#/$defs/styleStringOrScript" },
        "marginY": { "$ref": "#/$defs/styleStringOrScript" },
        "gap": { "$ref": "#/$defs/styleStringOrScript" },
        "color": { "$ref": "#/$defs/styleStringOrScript" },
        "backgroundColor": { "$ref": "#/$defs/styleStringOrScript" },
        "borderColor": { "$ref": "#/$defs/styleStringOrScript" },
        "borderWidth": { "$ref": "#/$defs/styleStringOrScript" },
        "borderRadius": { "$ref": "#/$defs/styleStringOrScript" },
        "fontSize": { "$ref": "#/$defs/styleStringOrScript" },
        "fontWeight": { "$ref": "#/$defs/styleStringNumberOrScript" },
        "lineHeight": { "$ref": "#/$defs/styleStringNumberOrScript" },
        "textAlign": {
          "oneOf": [
            { "type": "string", "enum": ["left", "center", "right", "justify", "start", "end"] },
            { "$ref": "#/$defs/propertyScript" }
          ]
        },
        "alignSelf": {
          "oneOf": [
            { "type": "string", "enum": ["auto", "start", "center", "end", "stretch"] },
            { "$ref": "#/$defs/propertyScript" }
          ]
        },
        "justifySelf": {
          "oneOf": [
            { "type": "string", "enum": ["auto", "start", "center", "end", "stretch"] },
            { "$ref": "#/$defs/propertyScript" }
          ]
        },
        "shadow": {
          "oneOf": [
            { "type": "string", "enum": ["none", "xs", "sm", "md", "lg"] },
            { "$ref": "#/$defs/propertyScript" }
          ]
        },
        "opacity": {
          "oneOf": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "$ref": "#/$defs/propertyScript" }
          ]
        },
        "overflow": { "$ref": "#/$defs/styleStringOrScript" },
        "flex": { "$ref": "#/$defs/styleStringNumberOrScript" }
      },
      "additionalProperties": false
    },
    "visualProps": {
      "style": { "$ref": "#/$defs/controlledStyle" },
      "variant": {
        "type": "string",
        "enum": [
          "primary",
          "secondary",
          "outline",
          "ghost",
          "filled",
          "plain",
          "elevated",
          "interactive",
          "underline",
          "pills",
          "segmented",
          "solid",
          "dashed",
          "dotted",
          "danger"
        ]
      },
      "size": { "type": "string", "enum": ["sm", "md", "lg"] },
      "tone": { "type": "string", "enum": ["neutral", "brand", "success", "warning", "danger"] },
      "preset": {
        "type": "string",
        "enum": [
          "title",
          "subtitle",
          "body",
          "caption",
          "metric",
          "section",
          "toolbar",
          "grid",
          "form",
          "centered",
          "summary",
          "formPanel",
          "media",
          "avatar",
          "thumbnail",
          "hero",
          "logo",
          "inline",
          "badge",
          "buttonIcon",
          "status",
          "mediaCard",
          "heroMedia",
          "plain",
          "dense",
          "cardList"
        ]
      }
    },
    "formPlaceholder": { "type": "string" },
    "formDisabled": { "type": "boolean" },
    "formRequired": { "type": "boolean" },
    "formReadonly": { "type": "boolean" },
    "formHelpText": { "type": "string" },
    "formErrorText": { "type": "string" },
    "formValidationState": { "type": "string", "enum": ["default", "success", "warning", "error"] },
    "formDensity": { "type": "string", "enum": ["compact", "comfortable"] },
    "layoutRole": {
      "type": "string",
      "enum": ["default", "toolbar", "formRow", "actions", "metadata", "mediaObject", "centered"]
    },
    "density": { "type": "string", "enum": ["compact", "comfortable", "spacious"] },
    "staticOrDynamicChildren": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["path", "componentId"],
            "properties": {
              "path": { "type": "string" },
              "componentId": { "type": "string" }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "action": {
      "type": "object",
      "oneOf": [
        { "required": ["event"] },
        { "required": ["script"] }
      ],
      "properties": {
        "event": {
          "description": "用户交互事件",
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "context": {
              "description": "动作上下文数据，可包含静态值或 { path } 动态绑定",
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "script": {
          "description": "用户交互触发的受限本地脚本",
          "type": "object",
          "required": ["code"],
          "properties": {
            "code": { "type": "string", "minLength": 1, "maxLength": 2000 },
            "deps": {
              "type": "array",
              "maxItems": 32,
              "items": { "type": "string" }
            },
            "context": {
              "description": "脚本上下文数据，可包含静态值或 { path } 动态绑定",
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "Text": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "component": { "type": "string" },
        "text": { "$ref": "#/$defs/stringOrBinding" },
        "usageHint": {
          "description": "文本语义提示",
          "type": "string",
          "enum": ["h1", "h2", "h3", "h4", "h5", "caption", "body"]
        },
        "maxLines": { "type": "number" },
        "decoration": { "type": "string", "enum": ["none", "underline", "lineThrough", "overline"] },
        "emphasis": { "type": "string", "enum": ["default", "muted", "strong", "danger", "success", "warning"] },
        "role": {
          "type": "string",
          "enum": ["default", "price", "previousPrice", "discount", "status", "timestamp", "emptyState"]
        },
        "truncate": { "type": "boolean" },
        "style": { "$ref": "#/$defs/visualProps/style" },
        "variant": { "type": "string", "enum": ["title", "subtitle", "body", "caption", "metric"] },
        "size": { "$ref": "#/$defs/visualProps/size" },
        "tone": { "$ref": "#/$defs/visualProps/tone" },
        "preset": { "$ref": "#/$defs/visualProps/preset" }
      },
      "additionalProperties": false
    },
    "Image": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "component": { "type": "string" },
        "url": { "$ref": "#/$defs/stringOrBinding" },
        "alt": { "type": "string" },
        "fit": { "type": "string", "enum": ["contain", "cover", "fill", "none", "scale-down"] },
        "aspectRatio": { "type": "string" },
        "loading": { "type": "string", "enum": ["lazy", "eager"] },
        "role": { "type": "string", "enum": ["image", "avatar", "thumbnail", "cover", "logo", "hero"] },
        "shape": { "type": "string", "enum": ["square", "rounded", "circle"] },
        "fallbackText": { "type": "string" },
        "caption": { "$ref": "#/$defs/stringOrBinding" },
        "style": { "$ref": "#/$defs/visualProps/style" },
        "variant": { "$ref": "#/$defs/visualProps/variant" },
        "size": { "$ref": "#/$defs/visualProps/size" },
        "tone": { "$ref": "#/$defs/visualProps/tone" },
        "preset": { "type": "string", "enum": ["avatar", "thumbnail", "hero", "logo"] }
      },
      "additionalProperties": false
    },
    "Icon": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "component": { "type": "string" },
        "name": { "$ref": "#/$defs/stringOrBinding" },
        "icon": {
          "description": "兼容旧字段，建议改用 name",
          "$ref": "#/$defs/stringOrBinding"
        },
        "semantic": { "type": "string", "enum": ["decorative", "status", "action", "navigation"] },
        "label": { "type": "string" },
        "status": { "type": "string", "enum": ["info", "success", "warning", "danger", "neutral"] },
        "style": { "$ref": "#/$defs/visualProps/style" },
        "variant": { "$ref": "#/$defs/visualProps/variant" },
        "size": { "$ref": "#/$defs/visualProps/size" },
        "tone": { "$ref": "#/$defs/visualProps/tone" },
        "preset": { "type": "string", "enum": ["inline", "badge", "buttonIcon", "status"] }
      },
      "additionalProperties": false
    },
    "Video": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "component": { "type": "string" },
        "url": { "$ref": "#/$defs/stringOrBinding" },
        "poster": { "$ref": "#/$defs/stringOrBinding" },
        "controls": { "type": "boolean" },
        "autoplay": { "type": "boolean" },
        "loop": { "type": "boolean" },
        "muted": { "type": "boolean" },
        "fit": { "type": "string", "enum": ["contain", "cover", "fill", "none", "scale-down"] },
        "aspectRatio": { "type": "string" },
        "density": { "type": "string", "enum": ["compact", "comfortable"] },
        "style": { "$ref": "#/$defs/visualProps/style" },
        "variant": { "$ref": "#/$defs/visualProps/variant" },
        "size": { "$ref": "#/$defs/visualProps/size" },
        "tone": { "$ref": "#/$defs/visualProps/tone" },
        "preset": { "type": "string", "enum": ["inline", "mediaCard", "heroMedia"] }
      },
      "additionalProperties": false
    },
    "AudioPlayer": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "component": { "type": "string" },
        "url": { "$ref": "#/$defs/stringOrBinding" },
        "controls": { "type": "boolean" },
        "autoplay": { "type": "boolean" },
        "loop": { "type": "boolean" },
        "muted": { "type": "boolean" },
        "density": { "type": "string", "enum": ["compact", "comfortable"] },
        "style": { "$ref": "#/$defs/visualProps/style" },
        "variant": { "$ref": "#/$defs/visualProps/variant" },
        "size": { "$ref": "#/$defs/visualProps/size" },
        "tone": { "$ref": "#/$defs/visualProps/tone" },
        "preset": { "type": "string", "enum": ["inline", "mediaCard"] }
      },
      "additionalProperties": false
    },
    "Divider": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "component": { "type": "string" },
        "orientation": { "type": "string", "enum": ["horizontal", "vertical"] },
        "thickness": { "type": "number" },
        "color": { "type": "string" },
        "spacing": { "type": "number" },
        "label": { "type": "string" },
        "labelAlign": { "type": "string", "enum": ["start", "center", "end"] },
        "style": { "$ref": "#/$defs/visualProps/style" },
        "variant": { "type": "string", "enum": ["solid", "dashed", "dotted"] },
        "size": { "$ref": "#/$defs/visualProps/size" },
        "tone": { "$ref": "#/$defs/visualProps/tone" },
        "preset": { "$ref": "#/$defs/visualProps/preset" }
      },
      "additionalProperties": false
    },
    "Row": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "component": { "type": "string" },
        "children": { "$ref": "#/$defs/staticOrDynamicChildren" },
        "distribution": { "type": "string", "enum": ["start", "center", "end", "spaceBetween", "spaceAround", "spaceEvenly"] },
        "alignment": { "type": "string", "enum": ["start", "center", "end", "stretch"] },
        "gap": { "type": "string" },
        "wrap": { "type": "boolean" },
        "role": { "$ref": "#/$defs/layoutRole" },
        "density": { "$ref": "#/$defs/density" },
        "divider": { "type": "string", "enum": ["none", "between", "after"] },
        "style": { "$ref": "#/$defs/visualProps/style" },
        "variant": { "$ref": "#/$defs/visualProps/variant" },
        "size": { "$ref": "#/$defs/visualProps/size" },
        "tone": { "$ref": "#/$defs/visualProps/tone" },
        "preset": { "type": "string", "enum": ["section", "toolbar", "grid", "form", "centered"] }
      },
      "additionalProperties": false
    },
    "Column": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "component": { "type": "string" },
        "children": { "$ref": "#/$defs/staticOrDynamicChildren" },
        "distribution": { "type": "string", "enum": ["start", "center", "end", "spaceBetween", "spaceAround", "spaceEvenly"] },
        "alignment": { "type": "string", "enum": ["start", "center", "end", "stretch"] },
        "gap": { "type": "string" },
        "wrap": { "type": "boolean" },
        "role": { "$ref": "#/$defs/layoutRole" },
        "density": { "$ref": "#/$defs/density" },
        "divider": { "type": "string", "enum": ["none", "between", "after"] },
        "style": { "$ref": "#/$defs/visualProps/style" },
        "variant": { "$ref": "#/$defs/visualProps/variant" },
        "size": { "$ref": "#/$defs/visualProps/size" },
        "tone": { "$ref": "#/$defs/visualProps/tone" },
        "preset": { "type": "string", "enum": ["section", "toolbar", "grid", "form", "centered"] }
      },
      "additionalProperties": false
    },
    "Grid": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "component": { "type": "string" },
        "children": { "$ref": "#/$defs/staticOrDynamicChildren" },
        "columns": {
          "oneOf": [
            { "type": "number", "minimum": 1 },
            { "type": "string", "enum": ["auto"] }
          ]
        },
        "minItemWidth": { "type": "string" },
        "gap": { "type": "string" },
        "density": { "$ref": "#/$defs/density" },
        "style": { "$ref": "#/$defs/visualProps/style" },
        "variant": { "$ref": "#/$defs/visualProps/variant" },
        "size": { "$ref": "#/$defs/visualProps/size" },
        "tone": { "$ref": "#/$defs/visualProps/tone" },
        "preset": { "type": "string", "enum": ["grid", "form", "cardList"] }
      },
      "additionalProperties": false
    },
    "Container": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "component": { "type": "string" },
        "child": { "$ref": "#/$defs/componentRef" },
        "width": { "type": "string", "enum": ["narrow", "content", "wide", "full"] },
        "padding": { "type": "string", "enum": ["none", "sm", "md", "lg"] },
        "align": { "type": "string", "enum": ["start", "center"] },
        "style": { "$ref": "#/$defs/visualProps/style" },
        "variant": { "$ref": "#/$defs/visualProps/variant" },
        "size": { "$ref": "#/$defs/visualProps/size" },
        "tone": { "$ref": "#/$defs/visualProps/tone" },
        "preset": { "type": "string", "enum": ["section", "centered", "formPanel"] }
      },
      "additionalProperties": false
    },
    "Spacer": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "component": { "type": "string" },
        "size": { "type": "string", "enum": ["xs", "sm", "md", "lg", "xl"] },
        "axis": { "type": "string", "enum": ["horizontal", "vertical"] },
        "flex": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "List": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "component": { "type": "string" },
        "children": { "$ref": "#/$defs/staticOrDynamicChildren" },
        "direction": { "type": "string", "enum": ["vertical", "horizontal"] },
        "marker": { "type": "string", "enum": ["none", "disc", "decimal", "check"] },
        "gap": { "type": "string" },
        "divided": { "type": "boolean" },
        "wrap": { "type": "boolean" },
        "emptyText": { "type": "string" },
        "loading": { "type": "boolean" },
        "itemRole": { "type": "string", "enum": ["default", "menuItem", "option", "article", "media", "card"] },
        "selection": { "type": "string", "enum": ["none", "single", "multiple"] },
        "dividers": { "type": "boolean" },
        "style": { "$ref": "#/$defs/visualProps/style" },
        "variant": { "$ref": "#/$defs/visualProps/variant" },
        "size": { "$ref": "#/$defs/visualProps/size" },
        "tone": { "$ref": "#/$defs/visualProps/tone" },
        "preset": { "type": "string", "enum": ["plain", "dense", "cardList", "grid"] }
      },
      "additionalProperties": false
    },
    "Card": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "component": { "type": "string" },
        "child": { "$ref": "#/$defs/componentRef" },
        "title": { "$ref": "#/$defs/stringOrBinding" },
        "header": { "$ref": "#/$defs/stringOrBinding" },
        "subtitle": { "$ref": "#/$defs/stringOrBinding" },
        "media": { "$ref": "#/$defs/componentRef" },
        "footer": { "$ref": "#/$defs/stringOrBinding" },
        "role": { "type": "string", "enum": ["default", "summary", "metric", "media", "form", "interactive", "emptyState"] },
        "density": { "$ref": "#/$defs/density" },
        "selected": { "type": "boolean" },
        "clickable": { "type": "boolean" },
        "style": { "$ref": "#/$defs/visualProps/style" },
        "variant": { "type": "string", "enum": ["plain", "outlined", "elevated", "filled", "interactive"] },
        "size": { "$ref": "#/$defs/visualProps/size" },
        "tone": { "$ref": "#/$defs/visualProps/tone" },
        "preset": { "type": "string", "enum": ["summary", "metric", "formPanel", "media"] }
      },
      "additionalProperties": false
    },
    "Tabs": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "component": { "type": "string" },
        "tabItems": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "child"],
            "properties": {
              "title": { "type": "string" },
              "child": { "$ref": "#/$defs/componentRef" }
            },
            "additionalProperties": false
          }
        },
        "align": { "type": "string", "enum": ["start", "center", "end", "stretch"] },
        "fullWidth": { "type": "boolean" },
        "style": { "$ref": "#/$defs/visualProps/style" },
        "variant": { "type": "string", "enum": ["underline", "pills", "segmented"] },
        "size": { "$ref": "#/$defs/visualProps/size" },
        "tone": { "$ref": "#/$defs/visualProps/tone" },
        "preset": { "$ref": "#/$defs/visualProps/preset" }
      },
      "additionalProperties": false
    },
    "Modal": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "component": { "type": "string" },
        "child": { "$ref": "#/$defs/componentRef" },
        "trigger": { "$ref": "#/$defs/componentRef" },
        "visible": { "$ref": "#/$defs/booleanOrBinding" },
        "size": { "type": "string", "enum": ["sm", "md", "lg", "fullscreen"] },
        "placement": { "type": "string", "enum": ["center", "right", "bottom"] },
        "closeOnOverlayClick": { "type": "boolean" },
        "showCloseButton": { "type": "boolean" },
        "overlayOpacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "title": { "$ref": "#/$defs/stringOrBinding" },
        "footer": { "$ref": "#/$defs/componentRef" },
        "style": { "$ref": "#/$defs/visualProps/style" },
        "variant": { "$ref": "#/$defs/visualProps/variant" },
        "tone": { "$ref": "#/$defs/visualProps/tone" },
        "preset": { "$ref": "#/$defs/visualProps/preset" }
      },
      "additionalProperties": false
    },
    "Button": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "component": { "type": "string" },
        "child": { "$ref": "#/$defs/componentRef" },
        "label": { "$ref": "#/$defs/stringOrBinding" },
        "icon": { "$ref": "#/$defs/stringOrBinding" },
        "action": { "$ref": "#/$defs/action" },
        "fullWidth": { "type": "boolean" },
        "disabled": { "type": "boolean" },
        "loading": { "type": "boolean" },
        "iconPosition": { "type": "string", "enum": ["left", "right", "only"] },
        "intent": { "type": "string", "enum": ["default", "primary", "secondary", "danger", "success", "warning"] },
        "shape": { "type": "string", "enum": ["rounded", "pill", "square", "circle"] },
        "importance": { "type": "string", "enum": ["normal", "quiet", "prominent"] },
        "confirm": {
          "type": "object",
